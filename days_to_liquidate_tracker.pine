//@version=5
indicator("🟥Days to Liquidate & Volatility Risk Exit Tracker", overlay=false)

// 1. User & Risk Inputs
myPositionSize    = input.int(100000, title="Your Position Size (Shares/Tokens)")
baseParticipation = input.float(10.0, title="Base Daily Participation Rate (%)", minval=0.1, maxval=100.0)
minParticipation  = input.float(0.5, title="Minimum Participation Rate Floor (%)", minval=0.01, maxval=100.0)
adtvLength        = input.int(20, title="ADTV Benchmark Period")
atrLength         = input.int(14, title="ATR Volatility Period")
volDropThreshold  = input.float(30.0, title="Liquidity Alert: Volume Drop Threshold (%)", minval=1.0, maxval=99.0)
is24_7Market      = input.bool(false, title="24/7 Market (Crypto)? — affects 'Days' label only")

// 2. Market Dynamics & Volatility Calculations
adtv = ta.sma(volume, adtvLength)
atr  = ta.atr(atrLength)
closePrice = close

// Calculate standard volatility percentage relative to price
volatilityPct = closePrice > 0 ? (atr / closePrice) * 100.0 : na
// Benchmark normal volatility using a moving average of the ATR percentage
normalVolPct = ta.sma(volatilityPct, adtvLength)

// 3. Dynamic Participation Haircut for Crypto / Small-Caps
// If current volatility is higher than normal, scale down the participation rate to protect against wide spreads
volatilityScaleFactor = (not na(volatilityPct)) and (not na(normalVolPct)) and volatilityPct > normalVolPct and volatilityPct > 0
     ? (normalVolPct / volatilityPct)
     : 1.0

adjustedParticipationRaw = baseParticipation * volatilityScaleFactor
// Clamp so extreme vol spikes don't drive participation to near-zero (and days-to-liquidate to absurd values)
adjustedParticipation = math.max(adjustedParticipationRaw, minParticipation)

// 4. Liquidation Calculations
pctRate = adjustedParticipation / 100.0
maxDailySell = adtv * pctRate
daysToLiquidate = (not na(maxDailySell)) and maxDailySell > 0 ? myPositionSize / maxDailySell : na

// Track extreme thinning volume or extreme spikes in volatility (indicating wide spreads)
isVolumeThin = (not na(adtv)) and volume < (adtv * (1.0 - (volDropThreshold / 100.0)))
isHighRiskSpread = (not na(volatilityPct)) and (not na(normalVolPct)) and volatilityPct > (normalVolPct * 1.5) // Volatility is 50%+ higher than normal

// 5. Visual Rendering & Multi-Stage Alerts
plot(daysToLiquidate, title="Days to Liquidate", color=color.orange, linewidth=2)
hline(1.0, "1 Day Horizon", color=color.gray, linestyle=hline.style_dashed)

// Multi-stage background alerts
// Amber = Volume thinning out | Bright Red = Volatility shock / Bid liquidity collapse
bgcolor(isHighRiskSpread ? color.new(color.red, 80) : (isVolumeThin ? color.new(color.orange, 85) : na), title="Risk Level Background")

// Real-time Dashboard
var table infoTable = table.new(position = position.top_right, columns = 2, rows = 5, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    table.cell(infoTable, 0, 0, "ADTV (" + str.tostring(adtvLength) + "d):", text_color=color.white, text_size=size.small)
    string adtvStr = na(adtv) ? "N/A" : str.tostring(math.round(adtv))
    table.cell(infoTable, 1, 0, adtvStr, text_color=color.yellow, text_size=size.small)

    table.cell(infoTable, 0, 1, "Adj. Exit Rate:", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(adjustedParticipation, "#.##") + "%", text_color=color.aqua, text_size=size.small)

    // Daily Sell Amount = ADTV x Adj. Exit Rate (the actual number of shares/tokens to sell today)
    table.cell(infoTable, 0, 2, "Daily Sell Amount:", text_color=color.white, text_size=size.small)
    string sellAmountStr = na(maxDailySell) ? "N/A" : str.tostring(math.round(maxDailySell))
    table.cell(infoTable, 1, 2, sellAmountStr, text_color=color.lime, text_size=size.small)

    string daysLabel = is24_7Market ? "Days to Exit:" : "Trading Days to Exit:"
    table.cell(infoTable, 0, 3, daysLabel, text_color=color.white, text_size=size.small)
    string daysStr = na(daysToLiquidate) ? "N/A" : str.tostring(daysToLiquidate, "#.##") + " Days"
    table.cell(infoTable, 1, 3, daysStr, text_color=color.orange, text_size=size.small)

    string riskStatus = isHighRiskSpread ? "💥 SPREAD BLOWOUT" : (isVolumeThin ? "⚠️ THIN LIQUIDITY" : "✅ NORMAL")
    color statusColor = isHighRiskSpread ? color.red : (isVolumeThin ? color.orange : color.green)
    table.cell(infoTable, 0, 4, "Liquidity Risk:", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, riskStatus, text_color=statusColor, text_size=size.small)
